# Core release pinned to its shared image index; see README for available platforms.
DORARION_IMAGE=docker.io/kimc1992/dorarion-core:0.0.8@sha256:156e422514c7974010483a8938c579453d02f884353b9b4b9b9919537fed9f97
DORARION_PORT=3000
DORARION_BIND_ADDRESS=127.0.0.1
# HTTP development only; HTTPS public URLs always force secure cookies.
DORARION_COOKIE_SECURE=false
DORARION_STALE_RUN_HOURS=24
DORARION_LOG_MAX_SIZE=10m
DORARION_LOG_MAX_FILES=30
DORARION_PUBLIC_URL=http://localhost:3000

POSTGRES_USER=dorarion
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=dorarion
DB_CONNECTION_POOL_SIZE=15
DORARION_DB_STATEMENT_TIMEOUT_MS=30000

JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=dorarion-core
JWT_AUDIENCE=dorarion-api
JWT_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=2592000

# Generate once with: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
SECRET_ENCRYPTION_KEY_REF=local:v1
# Exact DNS names/IPs or CIDRs, comma-separated. No URLs or host:port values.
DORARION_ALLOWED_PRIVATE_PROVIDER_HOSTS=
DORARION_ALLOWED_PRIVATE_WEBHOOK_HOSTS=
# Deprecated broad override; prefer the two allowlists above.
ALLOW_PRIVATE_WEBHOOK_DESTINATIONS=false

# The exact Compose database host is trusted internally; external databases need TLS.
# Environment-backed external credentials use env://DORARION_EXT_<NAME>.
# Core secrets cannot be allowlisted. Restart after changing installation policy.
DORARION_SECRET_ENV_ALLOWLIST=
DORARION_README_IMAGE_ORIGINS=
# DORARION_EXT_SLACK_OPERATIONS_WEBHOOK=https://hooks.slack.com/services/...
# DORARION_TRUSTED_PROXIES=172.20.0.2/32
# DORARION_REPORT_RECIPIENT_DOMAINS=example.com
# DORARION_METRICS_SCRAPE_TOKEN=<random-32-to-512-ASCII-characters>
# Mount a corporate CA file and set DORARION_CA_FILE to its container path.
